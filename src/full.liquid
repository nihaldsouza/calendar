<div class="layout gap--medium">
  <span class="value text--small">DBG[{{ debug_error }}][{{ debug_input_type }}][{{ debug_input_repr }}]</span>
  <div class="columns layout--center gap--medium">
    <div class="column w--auto">
      <span class="value text--xxxlarge">{{ month_label }}</span>
    </div>
    <div class="column">
      {% for h in upcoming %}
      <span class="label">{{ h.short_date }} · {{ h.name }}</span>
      {% endfor %}
    </div>
  </div>

  <div class="grid grid--cols-7 gap--small">
    {% for wd in weekday_labels %}
    <div class="item"><div class="content"><span class="label">{{ wd }}</span></div></div>
    {% endfor %}
    {% for week in weeks %}
      {% for d in week %}
      <div class="item">
        <div class="content">
          {% if d.in_month == false %}
          <span class="value text--large">&nbsp;</span>
          {% elsif d.is_today %}
          <span class="label label--inverted text--large">{{ d.day }}</span>
          {% elsif d.is_dim %}
          <span class="value text--large text--gray-50">{{ d.day }}</span>
          {% else %}
          <span class="value text--large">{{ d.day }}</span>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Calendar</span>
  {% if upcoming.size > 0 %}
  <span class="instance">Next: {{ upcoming[0].name }}</span>
  {% endif %}
</div>
