<div class="layout layout--col layout--start layout--stretch-x gap--medium">
  <div class="layout layout--col layout--start layout--stretch-x grow basis--0 gap--small">
    <span class="label text--large">{{ month_short }} {{ year }}</span>

    <div class="grid grid--cols-7 gap--xsmall">
      {% for wd in weekday_labels %}
      <div class="item"><div class="content"><span class="label text--xxlarge">{{ wd }}</span></div></div>
      {% endfor %}
      {% for week in weeks %}
        {% for d in week %}
        <div class="item">
          <div class="content content--center">
            {% if d.in_month == false %}
            <span class="value text--xxlarge">&nbsp;</span>
            {% elsif d.is_today %}
            <span class="label label--inverted text--xxlarge">{{ d.day }}</span>
            {% elsif d.is_dim %}
            <span class="value text--xxlarge text--gray-50">{{ d.day }}</span>
            {% else %}
            <span class="value text--xxlarge">{{ d.day }}</span>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  <div class="layout layout--col layout--start layout--stretch-x grow basis--0 gap--xsmall">
    {% for h in month_items %}
    <div class="grid grid--cols-1 gap--none">
      <span class="label label--inverted {{ holiday_text_class }}" style="background-color: var(--gray-50)">{{ h.short_date }}</span>
      {% for name in h.names %}
      <span class="value {{ holiday_text_class }}">{{ name }}</span>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</div>
